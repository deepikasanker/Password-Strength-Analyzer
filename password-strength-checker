Entered import math, re, string

# Sample leaked passwords for dictionary check
COMMON_PASSWORDS = ["password", "123456", "qwerty", "admin", "letmein", "welcome"]

def calculate_entropy(password):
    charset = 0
    if re.search(r'[a-z]', password): charset += 26
    if re.search(r'[A-Z]', password): charset += 26
    if re.search(r'[0-9]', password): charset += 10
    if re.search(r'[^A-Za-z0-9]', password): charset += 32
    if charset == 0: return 0
    return len(password) * math.log2(charset)

def check_password(password):
    print(f"\nChecking: {password}")
    print("-" * 30)
    
    # Step 2: Dictionary check
    if password.lower() in COMMON_PASSWORDS:
        print("⚠️  FOUND IN DICTIONARY LEAK! Very Risky!")
    
    # Step 1: Policy Criteria
    policy = {
        "Length >= 8": len(password) >= 8,
        "Uppercase [A-Z]": bool(re.search(r'[A-Z]', password)),
        "Lowercase [a-z]": bool(re.search(r'[a-z]', password)),
        "Digit [0-9]": bool(re.search(r'[0-9]', password)),
        "Special Char": bool(re.search(r'[^A-Za-z0-9]', password))
    }
    
    for rule, passed in policy.items():
        print(f"{rule}: {'✅' if passed else '❌'}")
    
    # Step 2: Entropy
    entropy = calculate_entropy(password)
    print(f"\nEntropy Score: {entropy:.2f} bits")
    
    # Step 3: Classify
    if entropy < 28: strength = "Weak"
    elif entropy < 50: strength = "Moderate"
    elif entropy < 70: strength = "Strong"
    else: strength = "Exceptional"
    
    print(f"Strength: {strength}")
    
    # Step 4: Feedback
    print("\nFeedback:")
    if not policy["Length >= 8"]: print("- Make it at least 8 characters")
    if not policy["Uppercase [A-Z]"]: print("- Add an Uppercase letter")
    if not policy["Lowercase [a-z]"]: print("- Add a Lowercase letter")
    if not policy["Digit [0-9]"]: print("- Add a number")
    if not policy["Special Char"]: print("- Add a special char like @#$")
    if all(policy.values()) and strength in ["Strong", "Exceptional"]:
        print("- Great! Your password is strong.")
    
    return strength

# Demo
check_password("password123")
check_password("MyS3cure@Pass123")
